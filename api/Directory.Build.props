<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- packages.lock.json per project, read by the locked-mode restore in CI and the images. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The images restore for linux-x64; the lock files must cover that graph too (plan C4). -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
