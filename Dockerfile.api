# The API: Jobwright.Api on ASP.NET Core 10.0.14, run as the image's non-root user (APP_UID).
# Build from the repository root, so global.json and dotnet-tools.json are in the context (plan V5):
# docker build -f Dockerfile.api .
# Base digests: plans/NEW-jobwright/part-1/progress-slice-0-ci.md, "Image digests".

FROM mcr.microsoft.com/dotnet/sdk:10.0.403@sha256:212fe4cb74627d5adf9817a4088906ae3edff1bd853bb27565d4b46731efe61e AS build
# Tool telemetry off (plan Q13)
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    TESTINGPLATFORM_TELEMETRY_OPTOUT=1
WORKDIR /src
COPY global.json dotnet-tools.json ./
COPY api/Directory.Build.props api/Directory.Packages.props api/
COPY api/src/ api/src/
RUN dotnet restore api/src/Jobwright.Api/Jobwright.Api.csproj --locked-mode
RUN dotnet publish api/src/Jobwright.Api/Jobwright.Api.csproj -c Release --no-restore -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0.14@sha256:1a48394b6f29d3a32c79d9edecd4abda0ecbe8776d567dbfc4590ed6979c740c
WORKDIR /app
COPY --from=build /app ./
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "Jobwright.Api.dll"]
